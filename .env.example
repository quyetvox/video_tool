# API Keys for Cloud Translator (OpenAI / Groq / Gemini / DeepSeek / OpenRouter)
OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Custom Base URL (Optional: defaults to https://api.openai.com/v1)
# For Groq: https://api.groq.com/openai/v1
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_BASE_URL=https://api.openai.com/v1
PYTHONPYCACHEPREFIX=.venv/pycache
