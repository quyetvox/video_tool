# ==============================================================================
# Sub-Video (AI Video Translator) - Git Ignore Configuration
# ==============================================================================

# ── 1. Python & Virtual Environments ──────────────────────────────────────────
.venv/
venv/
ENV/
env/
*.py[cod]
*$py.class
__pycache__/
**/__pycache__/
.pytest_cache/
.coverage
htmlcov/
.agents/

# ── 2. Node.js & Web GUI Dependencies ─────────────────────────────────────────
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# GUI Build Output & Cache
gui/dist/
gui/build/
gui/.vite/
.vite/
dist/

# ── 3. Environment, Secrets & Config ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
config.yaml
**/config.yaml

# ── 4. Documentation & Design Notes ─────────────────────────────────────────
docs/
**/docs/

# ── 4. Assets, Workspace & Generated Pipeline Outputs ─────────────────────────
assets/
**/assets/

# Legacy workspace/input/output directories
workspace/
input/
output/
temp/
tmp/
.temp/

# Ignore Media Files (Avoid committing large video/audio assets)
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.flv
*.wav
*.mp3
*.aac
*.flac
*.m4a
*.ogg

# ── 5. AI Models & Large Weights ──────────────────────────────────────────────
models/*
!models/README.md
!models/.gitkeep
*.pth
*.pt
*.bin
*.onnx
*.safetensors
*.ckpt

# ── 6. OS & IDE System Files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE Settings & Logs
.vscode/
.idea/
*.swp
*.swo
*~
